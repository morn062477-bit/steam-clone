# 이 파일을 .env 로 복사한 뒤 실제 값을 채운다. .env 는 커밋되지 않는다.

# 로컬 embedded-postgres (기본값). pnpm db:start 로 기동, 비밀번호는 postgres 고정.
# 자격 증명이 필요 없어서 별도 세팅 없이 바로 쓸 수 있다.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/steamclone?schema=public"

# AWS RDS를 쓰려면 위 줄을 주석 처리하고 이 줄의 주석을 풀어 실제 값을 채운다.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# 서버 포트. apps/web/next.config.ts가 4000번으로 프록시하므로
# apps/web과 같이 띄울 때는 반드시 4000으로 맞춘다.
PORT=4000
