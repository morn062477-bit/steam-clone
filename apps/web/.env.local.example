# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채운다. .env.local 은 커밋되지 않는다.
# apps/api/.env의 PORTONE_API_SECRET과 같은 가맹점(포트원 상점)의 값이어야 한다.
# 발급: https://admin.portone.io/integration-v2/manage/channel

NEXT_PUBLIC_PORTONE_STORE_ID=
# 결제창에서 고를 결제수단 3개. 각각 포트원 콘솔에 등록한 채널의 채널 키.
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_KAKAOPAY=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_INICIS=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY_TOSS=
